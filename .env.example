# ==============================================================================
# StudyAI - Environment Configuration Template
# Copy this file to .env and customize values for your local environment.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Server Port
PORT=8080

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/studyai_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_mysql_password_here

# JWT Security Configuration
# The secret must be at least 256 bits (32 bytes) for HMAC-SHA256
JWT_SECRET=your_random_secure_jwt_secret_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200

# File Upload Directory
UPLOAD_DIR=uploads/documents

# Python AI Microservice Configuration (RAG & Chunking)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_CONNECT_TIMEOUT_MS=5000
AI_SERVICE_READ_TIMEOUT_MS=15000
